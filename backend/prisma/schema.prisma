generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────

enum AppRole {
  customer
  staff
  manager_owner
  admin

  @@map("app_role")
}

enum AssetStatus {
  available
  reserved
  rented
  inspection_pending
  laundry
  maintenance
  damaged
  retired
  lost

  @@map("asset_status")
}

enum BookingStatus {
  draft
  pending_confirmation
  confirmed
  awaiting_payment
  paid
  preparing
  ready_for_pickup
  delivering
  renting
  returned
  inspection_pending
  completed
  cancelled
  rejected
  overdue

  @@map("booking_status")
}

enum PaymentStatus {
  pending
  paid
  failed
  cancelled
  refunding
  refunded
  partially_refunded

  @@map("payment_status")
}

enum InspectionStatus {
  pending
  in_progress
  completed
  disputed

  @@map("inspection_status")
}

enum MaintenanceStatus {
  open
  in_progress
  completed
  cannot_repair

  @@map("maintenance_status")
}

enum TryonStatus {
  pending
  processing
  completed
  failed

  @@map("tryon_status")
}

// ─────────────────────────────────────────────────────────
// AUTH / USER MODELS
// ─────────────────────────────────────────────────────────

model UserAccount {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String   @unique
  passwordHash    String   @map("password_hash")
  role            AppRole  @default(customer)
  isActive        Boolean  @default(true) @map("is_active")
  isEmailVerified Boolean  @default(false) @map("is_email_verified")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  profile            Profile?
  measurements       CustomerMeasurement[]
  addresses          Address[]
  bookings           Booking[]               @relation("BookingCustomer")
  emailVerifications EmailVerificationCode[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  statusHistories    BookingStatusHistory[]  @relation("StatusChangedBy")
  inspections        InspectionSession[]     @relation("InspectedBy")
  penaltiesCreated   Penalty[]
  refunds            Refund[]
  tryonRequests      TryonRequest[]

  @@map("user_accounts")
}

model EmailVerificationCode {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  code      String
  expiresAt DateTime    @map("expires_at") @db.Timestamptz(6)
  used      Boolean     @default(false)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  user      UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verification_codes")
}

model Profile {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String      @unique @map("user_id") @db.Uuid
  fullName  String?     @map("full_name")
  phone     String?
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime    @default(now()) @map("updated_at") @db.Timestamptz(6)
  user      UserAccount @relation(fields: [userId], references: [id])

  @@map("profiles")
}

model CustomerMeasurement {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId String      @map("customer_id") @db.Uuid
  heightCm   Decimal?    @map("height_cm") @db.Decimal(5, 2)
  weightKg   Decimal?    @map("weight_kg") @db.Decimal(5, 2)
  bustCm     Decimal?    @map("bust_cm") @db.Decimal(5, 2)
  waistCm    Decimal?    @map("waist_cm") @db.Decimal(5, 2)
  hipCm      Decimal?    @map("hip_cm") @db.Decimal(5, 2)
  usualSize  String?     @map("usual_size")
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  customer   UserAccount @relation(fields: [customerId], references: [id])

  @@map("customer_measurements")
}

model Address {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId   String      @map("customer_id") @db.Uuid
  receiverName String      @map("receiver_name")
  phone        String
  line1        String
  ward         String?
  district     String?
  city         String?
  isDefault    Boolean     @default(false) @map("is_default")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  customer     UserAccount @relation(fields: [customerId], references: [id])

  bookings Booking[] @relation("DeliveryAddress")

  @@map("addresses")
}

// ─────────────────────────────────────────────────────────
// GARMENT CATALOG MODELS
// ─────────────────────────────────────────────────────────

model GarmentCategory {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String    @unique
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  garments    Garment[]

  @@map("garment_categories")
}

model Garment {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId    String?          @map("category_id") @db.Uuid
  name          String
  description   String?
  sizeLabel     String?          @map("size_label")
  color         String?
  dailyPrice    Decimal          @default(0) @map("daily_price") @db.Decimal(12, 2)
  depositAmount Decimal          @default(0) @map("deposit_amount") @db.Decimal(12, 2)
  isActive      Boolean          @default(true) @map("is_active")
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  category      GarmentCategory? @relation(fields: [categoryId], references: [id])
  assets        GarmentAsset[]
  bookingItems  BookingItem[]
  images        GarmentImage[]
  tryonRequests TryonRequest[]

  @@map("garments")
}

model GarmentImage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  garmentId String   @map("garment_id") @db.Uuid
  imageUrl  String   @map("image_url")
  altText   String?  @map("alt_text")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  garment   Garment  @relation(fields: [garmentId], references: [id], onDelete: Cascade)

  @@map("garment_images")
}

model GarmentAsset {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  garmentId       String              @map("garment_id") @db.Uuid
  assetCode       String              @unique @map("asset_code")
  status          AssetStatus         @default(available)
  conditionNote   String?             @map("condition_note")
  purchaseCost    Decimal?            @map("purchase_cost") @db.Decimal(12, 2)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime            @default(now()) @map("updated_at") @db.Timestamptz(6)
  garment         Garment             @relation(fields: [garmentId], references: [id])
  bookingItems    BookingItem[]
  inspections     InspectionSession[]
  laundryTickets  LaundryTicket[]
  maintenanceJobs MaintenanceJob[]

  @@map("garment_assets")
}

// ─────────────────────────────────────────────────────────
// BOOKING MODELS
// ─────────────────────────────────────────────────────────

model Booking {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId        String        @map("customer_id") @db.Uuid
  status            BookingStatus @default(pending_confirmation)
  rentalStartDate   DateTime      @map("rental_start_date") @db.Date
  rentalEndDate     DateTime      @map("rental_end_date") @db.Date
  pickupMethod      String        @default("store_pickup") @map("pickup_method")
  deliveryAddressId String?       @map("delivery_address_id") @db.Uuid
  rentalTotal       Decimal       @default(0) @map("rental_total") @db.Decimal(12, 2)
  depositTotal      Decimal       @default(0) @map("deposit_total") @db.Decimal(12, 2)
  penaltyTotal      Decimal       @default(0) @map("penalty_total") @db.Decimal(12, 2)
  paymentDueAt      DateTime?     @map("payment_due_at") @db.Timestamptz
  note              String?
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)

  customer              UserAccount            @relation("BookingCustomer", fields: [customerId], references: [id])
  deliveryAddress       Address?               @relation("DeliveryAddress", fields: [deliveryAddressId], references: [id])
  items                 BookingItem[]
  statusHistory         BookingStatusHistory[]
  deliveryRecords       DeliveryRecord[]
  payments              Payment[]
  penalties             Penalty[]
  refunds               Refund[]
  financialTransactions FinancialTransaction[]
  inspections           InspectionSession[]
  laundryTickets        LaundryTicket[]

  @@map("bookings")
}

model BookingItem {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId      String        @map("booking_id") @db.Uuid
  garmentId      String        @map("garment_id") @db.Uuid
  garmentAssetId String?       @map("garment_asset_id") @db.Uuid
  dailyPrice     Decimal       @default(0) @map("daily_price") @db.Decimal(12, 2)
  depositAmount  Decimal       @default(0) @map("deposit_amount") @db.Decimal(12, 2)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  booking        Booking       @relation(fields: [bookingId], references: [id])
  garment        Garment       @relation(fields: [garmentId], references: [id])
  garmentAsset   GarmentAsset? @relation(fields: [garmentAssetId], references: [id])

  @@map("booking_items")
}

model BookingStatusHistory {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId     String         @map("booking_id") @db.Uuid
  fromStatus    BookingStatus? @map("from_status")
  toStatus      BookingStatus  @map("to_status")
  changedBy     String?        @map("changed_by") @db.Uuid
  note          String?
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  booking       Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  changedByUser UserAccount?   @relation("StatusChangedBy", fields: [changedBy], references: [id])

  @@map("booking_status_history")
}

model DeliveryRecord {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId       String    @map("booking_id") @db.Uuid
  method          String
  addressSnapshot String?   @map("address_snapshot")
  deliveredAt     DateTime? @map("delivered_at") @db.Timestamptz
  receivedAt      DateTime? @map("received_at") @db.Timestamptz
  note            String?
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  booking         Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("delivery_records")
}

// ─────────────────────────────────────────────────────────
// PAYMENT & FINANCE MODELS
// ─────────────────────────────────────────────────────────

model Payment {
  id                    String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId             String                 @map("booking_id") @db.Uuid
  provider              String                 @default("mock")
  providerTransactionId String?                @map("provider_transaction_id")
  paymentMethod         String?                @map("payment_method")
  amount                Decimal                @db.Decimal(12, 2)
  depositAmount         Decimal                @default(0) @map("deposit_amount") @db.Decimal(12, 2)
  status                PaymentStatus          @default(pending)
  paidAt                DateTime?              @map("paid_at") @db.Timestamptz
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  booking               Booking                @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  refunds               Refund[]
  financialTransactions FinancialTransaction[]

  @@map("payments")
}

model Penalty {
  id                    String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId             String                 @map("booking_id") @db.Uuid
  reason                String
  amount                Decimal                @db.Decimal(12, 2)
  createdBy             String?                @map("created_by") @db.Uuid
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  booking               Booking                @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  createdByUser         UserAccount?           @relation(fields: [createdBy], references: [id])
  financialTransactions FinancialTransaction[]

  @@map("penalties")
}

model Refund {
  id                    String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId             String                 @map("booking_id") @db.Uuid
  paymentId             String?                @map("payment_id") @db.Uuid
  amount                Decimal                @db.Decimal(12, 2)
  status                PaymentStatus          @default(pending)
  reason                String?
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  booking               Booking                @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  payment               Payment?               @relation(fields: [paymentId], references: [id])
  financialTransactions FinancialTransaction[]
  userAccount           UserAccount?           @relation(fields: [userAccountId], references: [id])
  userAccountId         String?                @db.Uuid

  @@map("refunds")
}

model FinancialTransaction {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId       String?  @map("booking_id") @db.Uuid
  paymentId       String?  @map("payment_id") @db.Uuid
  refundId        String?  @map("refund_id") @db.Uuid
  penaltyId       String?  @map("penalty_id") @db.Uuid
  transactionType String   @map("transaction_type")
  amount          Decimal  @db.Decimal(12, 2)
  note            String?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  booking         Booking? @relation(fields: [bookingId], references: [id])
  payment         Payment? @relation(fields: [paymentId], references: [id])
  refund          Refund?  @relation(fields: [refundId], references: [id])
  penalty         Penalty? @relation(fields: [penaltyId], references: [id])

  @@map("financial_transactions")
}

// ─────────────────────────────────────────────────────────
// INSPECTION MODELS
// ─────────────────────────────────────────────────────────

model InspectionSession {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId      String              @map("booking_id") @db.Uuid
  garmentAssetId String              @map("garment_asset_id") @db.Uuid
  status         InspectionStatus    @default(pending)
  inspectedBy    String?             @map("inspected_by") @db.Uuid
  note           String?
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt    DateTime?           @map("completed_at") @db.Timestamptz
  booking        Booking             @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  garmentAsset   GarmentAsset        @relation(fields: [garmentAssetId], references: [id])
  inspector      UserAccount?        @relation("InspectedBy", fields: [inspectedBy], references: [id])
  findings       InspectionFinding[]
  photos         InspectionPhoto[]

  @@map("inspection_sessions")
}

model InspectionFinding {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inspectionSessionId String            @map("inspection_session_id") @db.Uuid
  findingType         String            @map("finding_type")
  severity            String            @default("low")
  description         String?
  penaltyAmount       Decimal           @default(0) @map("penalty_amount") @db.Decimal(12, 2)
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  inspectionSession   InspectionSession @relation(fields: [inspectionSessionId], references: [id], onDelete: Cascade)
  maintenanceJobs     MaintenanceJob[]

  @@map("inspection_findings")
}

model InspectionPhoto {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inspectionSessionId String            @map("inspection_session_id") @db.Uuid
  imageUrl            String            @map("image_url")
  note                String?
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  inspectionSession   InspectionSession @relation(fields: [inspectionSessionId], references: [id], onDelete: Cascade)

  @@map("inspection_photos")
}

// ─────────────────────────────────────────────────────────
// LAUNDRY & MAINTENANCE MODELS
// ─────────────────────────────────────────────────────────

model LaundryTicket {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  garmentAssetId String            @map("garment_asset_id") @db.Uuid
  bookingId      String?           @map("booking_id") @db.Uuid
  status         MaintenanceStatus @default(open)
  note           String?
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt    DateTime?         @map("completed_at") @db.Timestamptz
  garmentAsset   GarmentAsset      @relation(fields: [garmentAssetId], references: [id])
  booking        Booking?          @relation(fields: [bookingId], references: [id])

  @@map("laundry_tickets")
}

model MaintenanceJob {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  garmentAssetId      String             @map("garment_asset_id") @db.Uuid
  inspectionFindingId String?            @map("inspection_finding_id") @db.Uuid
  status              MaintenanceStatus  @default(open)
  note                String?
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt         DateTime?          @map("completed_at") @db.Timestamptz
  garmentAsset        GarmentAsset       @relation(fields: [garmentAssetId], references: [id])
  inspectionFinding   InspectionFinding? @relation(fields: [inspectionFindingId], references: [id])

  @@map("maintenance_jobs")
}

// ─────────────────────────────────────────────────────────
// AI TRY-ON MODELS
// ─────────────────────────────────────────────────────────

model TryonRequest {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId      String        @map("customer_id") @db.Uuid
  garmentId       String        @map("garment_id") @db.Uuid
  status          TryonStatus   @default(pending)
  sourceImageUrl  String?       @map("source_image_url")
  consentAccepted Boolean       @default(false) @map("consent_accepted")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt     DateTime?     @map("completed_at") @db.Timestamptz
  customer        UserAccount   @relation(fields: [customerId], references: [id])
  garment         Garment       @relation(fields: [garmentId], references: [id])
  results         TryonResult[]

  @@map("tryon_requests")
}

model TryonResult {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tryonRequestId String       @map("tryon_request_id") @db.Uuid
  resultImageUrl String?      @map("result_image_url")
  aiMetadata     Json?        @map("ai_metadata") @db.JsonB
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  tryonRequest   TryonRequest @relation(fields: [tryonRequestId], references: [id], onDelete: Cascade)

  @@map("tryon_results")
}

// ─────────────────────────────────────────────────────────
// NOTIFICATION & UTILITY MODELS
// ─────────────────────────────────────────────────────────

model Notification {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?      @map("user_id") @db.Uuid
  title     String
  body      String?
  readAt    DateTime?    @map("read_at") @db.Timestamptz
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  user      UserAccount? @relation(fields: [userId], references: [id])

  @@map("notifications")
}

model AuditLog {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String?      @map("actor_id") @db.Uuid
  action     String
  entityType String       @map("entity_type")
  entityId   String?      @map("entity_id") @db.Uuid
  metadata   Json?        @db.JsonB
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  actor      UserAccount? @relation(fields: [actorId], references: [id])

  @@map("audit_logs")
}

model SystemSetting {
  key       String   @id
  value     Json     @db.JsonB
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("system_settings")
}
